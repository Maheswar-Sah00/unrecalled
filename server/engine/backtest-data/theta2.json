    "\\b(?:seized|seizing|seizure)\\s+(?:\\w+\\s+){0,2}?engine",
    "\\b(?:rod|connecting[\\s-]rod|bearing|crankshaft)\\s+(?:\\w+\\s+){0,3}?(?:knock\\w*|fail\\w*|spun|broke\\w*|damage\\w*|wear)",
    "\\b(?:knock\\w*|spun)\\s+(?:\\w+\\s+){0,3}?(?:rod|connecting[\\s-]rod|rod\\s+bearings?|bearings?)\\b",
    "\\bthr(?:ew|ow|own)\\s+a\\s+rod\\b",
    "\\bhole\\s+in\\s+(?:the\\s+)?(?:engine\\s+)?block\\b",
    "(?<!\\b(?:could|may|might|potential(?:ly)?|risk\\s+of|lead\\s+to|cause|result\\s+in|afraid|fear|prevent)\\s+(?:\\w+\\s+){0,3})\\b(?:catastrophic|complete|total|sudden|diagnosed\\s+(?:\\w+\\s+){0,2}?with)\\s+engine\\s+failure",
    "\\bengine\\s+(?:\\w+\\s+){0,2}?(?:needs?|needed|required|requires)\\s+(?:to\\s+be\\s+)?(?:a\\s+)?(?:replac\\w*|rebuil\\w*)",
    "\\b(?:new|replacement|replaced\\s+the)\\s+(?:short[\\s-]block|long[\\s-]block|engine\\s+block)\\b",
    "\\b(?:seized|seizing)\\b(?:\\s+up)?\\s+(?:on|while|at|in|going|driving)\\b",
    "\\bknock\\w*\\b[\\s\\S]{0,250}?\\b(?:died|stall\\w*|lost\\s+(?:all\\s+)?(?:engine\\s+)?power|loss\\s+of\\s+(?:engine\\s+|motive\\s+)?power|shut\\s+(?:off|down)|tow(?:ed)?|limp\\s+mode)\\b",
    "\\b(?:died|stall\\w*|lost\\s+(?:all\\s+)?(?:engine\\s+)?power|loss\\s+of\\s+(?:engine\\s+|motive\\s+)?power|shut\\s+(?:off|down))\\b[\\s\\S]{0,150}?\\b(?:engine\\s+(?:\\w+\\s+){0,2}?knock\\w*|knock\\w*\\s+(?:\\w+\\s+){0,3}?(?:noise|sound)\\s+(?:\\w+\\s+){0,3}?engine)"
  ],
  "notes": [
    "Population and recall date taken from the NHTSA recalls API for campaigns 17V224000, 17V226000 (report date 2017-03-31).",
    "Hyundai Sonata 2011–2012 is excluded: it was recalled earlier for the same bearing failure under 15V-568 (report date 2015-09-10). Measured against that earlier recall, the rule's lead would be 12 months.",
    "Peers: TOYOTA CAMRY, HONDA ACCORD, FORD FUSION, model years 2011–2014. Shares use complaints received before the recall date.",
    "Rule: cumulative matches >= 10 and cumulative share >= 5x cumulative peer share, evaluated monthly on complaint received dates.",
    "Data fetched 2026-11-06; NHTSA adds late-filed complaints, so counts can drift slightly."
  ]
